# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — never commit filled env files
.env*.local
.env.production
.env.staging
.env.development
# Allow only safe example/template files
!.env.*.example
!.env.example
!op-secrets.env.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
