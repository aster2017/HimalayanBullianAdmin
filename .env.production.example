# ─────────────────────────────────────────────────────────────────────────────
# HBC Web Admin — production environment template
# Copy to .env.production and fill values. Never commit the filled copy.
# For Docker builds these are injected as --build-arg, not from the file.
# ─────────────────────────────────────────────────────────────────────────────

# API endpoint for this environment
NEXT_PUBLIC_API_URL=https://hbcapi.semis.app/api

# Request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=30000

# Environment label shown in header/logs
NEXT_PUBLIC_ENV=production
